# DriveAware AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Project
PROJECT_NAME="DriveAware AI"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Security
DATABASE_URL="sqlite:///./driveaware.db"
SECRET_KEY="temporary-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Detection & Risk Thresholds
EAR_THRESHOLD=0.21
MAR_THRESHOLD=0.60
DROWSY_CLOSURE_DURATION_SEC=0.5
YAWN_DURATION_SEC=1.5
PERCLOS_WINDOW_SEC=60.0
CALIBRATION_DURATION_SEC=10.0

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000"
